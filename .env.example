# Database
# Supported: postgres, mysql, mariadb
DB_DRIVER=postgres
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=monitoring
DB_PORT=5432
DB_SSLMODE=disable
# MongoDB (only needed when DB_DRIVER=mongo)
DB_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/monitoring?retryWrites=true&w=majority

# Telegram Bot
BOT_TOKEN=

# JWT
JWT_SECRET=change-me-in-production

# Server
PORT=8080
