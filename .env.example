# Database
# Supported: postgres, mysql, mariadb
DB_DRIVER=postgres
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=monitoring
DB_PORT=5432
DB_SSLMODE=disable
# MongoDB (only needed when DB_DRIVER=mongo)
DB_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/monitoring?retryWrites=true&w=majority

# Alert configuration
ALERT_DEBOUNCE_MINUTES=2

# Telegram Bot
BOT_TOKEN=

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRY_MINUTES=1440

# CAPTCHA
# Supported: local, turnstile, none
CAPTCHA_PROVIDER=local
# Required when CAPTCHA_PROVIDER=local (32+ character random string)
CAPTCHA_SECRET=change-me-32-char-random-string
# Required when CAPTCHA_PROVIDER=turnstile (Cloudflare Turnstile secret key)
TURNSTILE_SECRET_KEY=

# Server & Logging
PORT=8080
GIN_MODE=release
DEBUG_LOG=false

# Log Retention Policy (days to retain logs before daily 03:00 AM auto-cleanup; 0 to disable)
AUDIT_LOG_RETENTION_DAYS=30
SECURITY_LOG_RETENTION_DAYS=30
SCHEDULE_RUN_RETENTION_DAYS=30

